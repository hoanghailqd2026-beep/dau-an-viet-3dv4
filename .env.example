# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional OAuth 2.0 Client IDs for custom production domains.
# Inside Google AI Studio iframe or when left empty, built-in secure modal verification runs seamlessly.
VITE_GOOGLE_CLIENT_ID=""
VITE_FACEBOOK_APP_ID=""

# Optional background email webhook URL (e.g., Formspree, EmailJS/Make/Apps Script webhook)
# Used by AI Autonomous Admin Copilot to silently forward Support Tickets & Security Alerts to bivsmoon2023@gmail.com.
VITE_EMAIL_WEBHOOK_URL=""

# Optional Firebase Realtime Database URL for instant REST (.json) sync across Vercel/Remix/devices
VITE_FIREBASE_DB_URL=""

